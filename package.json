{
  "name": "soulmirror",
  "version": "1.2.3",
  "description": "SoulMirror 娴兼俺顔呴崝鈺傚閿涙艾鐤勯弮鎯版祮閸愭瑣鈧椒绱扮拋顔跨槕閸掝偁鈧椒绱伴崥搴ｉ偗鐟曚礁鍙嗘惔鎿勭幢娴滅儤鐗哥粻锛勫殠閿涘牏鏁ら幋宄板幢+鐠併倗鐓￠弸鑸电€?娴滄柨鐪伴悽璇插剼+閸ユ稑鐪扮拋鏉跨箓閿涘绉洪悽銊ㄧШ閸嶅繑婀版禍鐚寸幢閸愬懐鐤嗗鏃傜矊濡€崇础",
  "type": "module",
  "main": "index.js",
  "license": "MIT",
  "keywords": [
    "dsh",
    "soulmirror",
    "digital-twin",
    "meeting",
    "asr",
    "tts",
    "wemeet",
    "automation",
    "realtime-asr",
    "demo-mode",
    "health-check",
    "persona",
    "soul",
    "memory-layers",
    "digital-twin-persona"
  ],
  "exports": {
    ".": {
      "default": "./index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale"
      ]
    },
    "compatibility": {
      "node": ">=22"
    }
  },
  "files": [
    "manifest.json",
    "index.js",
    "lib/",
    "tools/mbridge.exe",
    "tools/meeting-bridge.cs",
    "tools/ui.ps1",
    "tools/mic.ps1",
    "tools/hold.ps1",
    "tools/README.md",
    "cordis.patch.yml",
    "README.md",
    "assets/",
    "docs/"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.1.2-rc.1 <1.0.0",
    "@deepseek-ai/schemastery": ">=3.18.2 <4",
    "react": ">=18.2.0 <19"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "scripts": {
    "test": "node --test --test-concurrency=4 \"tests/*.test.mjs\"",
    "check:scope": "node scripts/check-scope.mjs",
    "test:rules": "node --test --test-concurrency=2 --test-timeout=30000 tests/development-rules.test.mjs tests/key-consistency.test.mjs",
    "check:dev": "npm run check:scope && npm run test:rules"
  },
  "engines": {
    "node": ">=22"
  }
}
